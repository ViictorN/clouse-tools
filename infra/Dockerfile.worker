# ==============================================================================
# CLOUSE TOOLS — Isolated Sandbox Worker Container (infra/Dockerfile.worker)
# Controls: PDF 1 Domain 15 & PDF 2 Domains 14, 18 (zero exposed ports, non-root)
# ==============================================================================
FROM node:22.14.0-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm cache clean --force

FROM node:22.14.0-alpine AS runtime
RUN apk add --no-cache ffmpeg
WORKDIR /app
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512 --disallow-code-generation-from-strings"

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json tsconfig.json ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node packages ./packages
COPY --chown=node:node apps/worker ./apps/worker

USER node

CMD ["npx", "tsx", "apps/worker/src/worker.ts"]
