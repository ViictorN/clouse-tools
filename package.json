{
  "name": "clouse-tools",
  "version": "1.0.0",
  "description": "Hybrid privacy-first toolbox with 67 client-side browser tools, modular Express/Next.js backend, Supabase RLS/Storage architecture, isolated sandbox workers, and 2,500 verified security controls.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/worker.ts",
    "icons": "node scripts/generate-icons.mjs",
    "db:bundle": "tsx scripts/build-supabase-bundle.ts",
    "db:link": "npx supabase link --project-ref nsylafldndrhgkrgpiwb",
    "db:push": "npx supabase db push --linked --include-seed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/security-and-compliance.test.ts tests/api-and-worker.test.ts",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "next start"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ViictorN/clouse-tools.git"
  },
  "keywords": [
    "tools",
    "online-tools",
    "calculator",
    "unit-converter",
    "developer-tools",
    "text-tools",
    "privacy-first",
    "supabase",
    "security-governance"
  ],
  "author": "Victor Gomes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ViictorN/clouse-tools/issues"
  },
  "homepage": "https://github.com/ViictorN/clouse-tools#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
