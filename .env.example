# ==============================================================================
# CLOUSE TOOLS — Environment Configuration (.env.example)
# Target Supabase Project: nsylafldndrhgkrgpiwb
# SECURITY RULE (CT-021 / CT-337): NEVER commit real secrets (.env / .env.local)
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Public Web & API Gateway ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://clouse.app
TRUST_PROXY_HOPS=1

# --- Supabase (Project Ref: nsylafldndrhgkrgpiwb) ---
SUPABASE_PROJECT_REF=nsylafldndrhgkrgpiwb
NEXT_PUBLIC_SUPABASE_URL=https://nsylafldndrhgkrgpiwb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-publishable-key

# SERVER / WORKER ONLY — NEVER expose with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-secret-key
DATABASE_URL=postgresql://postgres.nsylafldndrhgkrgpiwb:replace-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Authentication, Sessions & CSRF ---
JWT_ISSUER=https://nsylafldndrhgkrgpiwb.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
CSRF_HMAC_SECRET=replace-with-at-least-32-bytes-cryptographic-random-hex
PASSWORD_PEPPER=replace-with-at-least-32-bytes-cryptographic-random-hex
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# --- Uploads, Sandbox & Worker Quotas ---
MAX_JSON_BODY_BYTES=65536
MAX_UPLOAD_FILE_BYTES=26214400
MAX_USER_STORAGE_QUOTA_BYTES=104857600
ARTIFACT_TTL_SECONDS=900
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_MS=15000
WORKER_MAX_MEMORY_MB=256
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe

# --- Optional Redis / Upstash Distributed Cache & Rate Limit Adapter ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional Billing / Stripe Webhooks (Sandbox Separated) ---
BILLING_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
